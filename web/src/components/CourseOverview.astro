---
import { CardGrid, LinkCard } from '@astrojs/starlight/components'
import { lessons } from '../../../scripts/lessons.ts'
import { metadata, stages } from '../../meta.ts'
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
---
{stages.map((stage, index) => <section>
  <h3>{stage.range} · {stage.name}</h3>
  <p>{stage.description}</p>
  <CardGrid>
    {lessons.filter(([id]) => metadata[id]?.stage === index).map(([id]) => (
      <LinkCard title={`${id.slice(1, 3)} · ${metadata[id]!.title}`} description={metadata[id]!.summary} href={`${base}lessons/${id}/`} />
    ))}
  </CardGrid>
</section>)}
