{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"],
    "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../scripts/lessons.ts"]
}
